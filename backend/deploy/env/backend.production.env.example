NODE_ENV=production
PORT=3100

DATABASE_URL=postgresql://postgres:CHANGE_DB_PASSWORD@127.0.0.1:5432/medlifecycle?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=14

PUBLIC_API_BASE_URL=https://arogyaapi.yaduraj.me
CORS_ALLOWED_ORIGINS=https://arogya.yaduraj.me
COOKIE_DOMAIN=.yaduraj.me
COOKIE_SAME_SITE=lax

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30
ENABLE_PUBLIC_LEADS=true

LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_MODEL=dolphin3.0-llama3.1-8b

STORAGE_PATH=/srv/medlifecycle/shared/uploads
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_DIR=/srv/medlifecycle/shared/uploads
DOCUMENT_UPLOAD_MAX_MB=20
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_TIMEOUT_MS=45000
DOCUMENT_EXTRACTION_MAX_TEXT_CHARS=16000

ENCRYPTION_KEY=CHANGE_TO_32_PLUS_CHAR_SECRET

NOTIFY_AUTO_DISPATCH=true
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_WEBHOOK_TIMEOUT_MS=5000
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_EMAIL_WEBHOOK_TOKEN=
NOTIFY_SMS_WEBHOOK_URL=
NOTIFY_SMS_WEBHOOK_TOKEN=
NOTIFY_PUSH_WEBHOOK_URL=
NOTIFY_PUSH_WEBHOOK_TOKEN=
NOTIFY_WEBHOOK_TOKEN=
