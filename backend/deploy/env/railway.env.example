# Copy these into Railway → Backend service → Variables
# DATABASE_URL is auto-injected when you attach Railway Postgres.

NODE_ENV=production

# Leave PORT unset — Railway injects it automatically.

JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=14

# After first deploy, set this to your public Railway URL, e.g.:
# https://medlifecycle-api-production.up.railway.app
PUBLIC_API_BASE_URL=https://YOUR-BACKEND.up.railway.app

# Comma-separated frontend origins (Vercel, local, custom domain)
CORS_ALLOWED_ORIGINS=https://arogya.yaduraj.me,http://localhost:8080

# Cross-site (Railway API + Vercel FE): empty domain + none
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none

PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=30
ENABLE_PUBLIC_LEADS=true

# Optional AI (can leave as-is for first deploy)
LLM_ENDPOINT=
LLM_MODEL=

# Ephemeral disk on Railway free tier — OK for smoke tests; use S3/R2 later
STORAGE_PATH=/tmp/uploads
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_DIR=/tmp/uploads
DOCUMENT_UPLOAD_MAX_MB=20
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_TIMEOUT_MS=45000
DOCUMENT_EXTRACTION_MAX_TEXT_CHARS=16000

ENCRYPTION_KEY=CHANGE_TO_32_PLUS_CHAR_SECRET

NOTIFY_AUTO_DISPATCH=false
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_WEBHOOK_TIMEOUT_MS=5000
